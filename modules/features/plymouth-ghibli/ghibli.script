## Ghibli plymouth theme — a soot sprite drifting among fireflies in a forest night

screen.w = Window.GetWidth(0);
screen.h = Window.GetHeight(0);

Window.SetBackgroundTopColor(0.149, 0.227, 0.180);
Window.SetBackgroundBottomColor(0.059, 0.094, 0.075);

# ---- soot sprite ----
soot = null;
soot.image = Image("soot_sprite.png");
soot.scale = screen.w * 0.08;
soot.image = soot.image.Scale(soot.scale, soot.scale);
soot.sprite = Sprite(soot.image);
soot.base_y = screen.h * 0.42;
soot.sprite.SetX(screen.w / 2 - soot.image.GetWidth() / 2);
soot.sprite.SetY(soot.base_y);
soot.sprite.SetZ(10);

# ---- fireflies ----
firefly_image = Image("firefly.png");
firefly_scale = screen.w * 0.02;
firefly_image = firefly_image.Scale(firefly_scale, firefly_scale);

firefly1 = null;
firefly2 = null;
firefly3 = null;
firefly1.sprite = Sprite(firefly_image);
firefly2.sprite = Sprite(firefly_image);
firefly3.sprite = Sprite(firefly_image);
firefly1.sprite.SetZ(5);
firefly2.sprite.SetZ(5);
firefly3.sprite.SetZ(5);
firefly1.x = screen.w * 0.38;
firefly2.x = screen.w * 0.62;
firefly3.x = screen.w * 0.50;

# ---- progress bar ----
bar = null;
bar.width = screen.w * 0.26;
bar.height = screen.h * 0.006;
if (bar.height < 3) {
  bar.height = 3;
}

bar.track_image = Image("progress_bar.png");
bar.track_image = bar.track_image.Scale(bar.width, bar.height);
bar.track_sprite = Sprite(bar.track_image);
bar.track_sprite.SetX(screen.w / 2 - bar.width / 2);
bar.track_sprite.SetY(screen.h * 0.72);
bar.track_sprite.SetZ(1);
bar.track_sprite.SetOpacity(0.25);

bar.fill_base_image = Image("progress_bar.png");
bar.fill_sprite = Sprite(bar.fill_base_image.Scale(1, bar.height));
bar.fill_sprite.SetX(screen.w / 2 - bar.width / 2);
bar.fill_sprite.SetY(screen.h * 0.72);
bar.fill_sprite.SetZ(2);

# ---- animation ----
time = 0;

fun refresh_callback() {
  time++;

  bob = Math.Sin(time * 0.06) * (screen.h * 0.01);
  soot.sprite.SetY(soot.base_y + bob);

  firefly1.sprite.SetX(firefly1.x + Math.Sin(time * 0.02) * (screen.w * 0.01));
  firefly1.sprite.SetY(screen.h * 0.30 + Math.Sin(time * 0.03) * (screen.h * 0.03));
  firefly1.sprite.SetOpacity(0.5 + 0.5 * Math.Sin(time * 0.08));

  firefly2.sprite.SetX(firefly2.x + Math.Cos(time * 0.025) * (screen.w * 0.01));
  firefly2.sprite.SetY(screen.h * 0.34 + Math.Cos(time * 0.045 + 1) * (screen.h * 0.025));
  firefly2.sprite.SetOpacity(0.5 + 0.5 * Math.Sin(time * 0.09 + 1));

  firefly3.sprite.SetX(firefly3.x + Math.Sin(time * 0.03 + 1) * (screen.w * 0.01));
  firefly3.sprite.SetY(screen.h * 0.26 + Math.Sin(time * 0.05 + 2) * (screen.h * 0.02));
  firefly3.sprite.SetOpacity(0.5 + 0.5 * Math.Sin(time * 0.07 + 2));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
  fill_width = bar.width * progress;
  if (fill_width < 1) {
    fill_width = 1;
  }
  bar.fill_sprite.SetImage(bar.fill_base_image.Scale(fill_width, bar.height));
}
Plymouth.SetBootProgressFunction(progress_callback);
